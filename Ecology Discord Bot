import discord
import requests
from discord.ext import commands
intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix='$', intents=intents)

@bot.command()
async def Komendy(ctx):
    await ctx.send("Info: Commands: $help = Shows all available commands, $start = Give steps on how to use info to start, $info = Provides info about waste reduction , $ile = Provides information on how long it takes for different types of waste to decompose.")

@bot.command()
async def info(ctx):
    await ctx.send("To reduce waste, you can follow these steps: 1. Reduce: Minimize the amount of waste you produce by being mindful of your consumption habits. 2. Reuse: Find ways to reuse items instead of throwing them away. 3. Recycle: Properly sort and recycle materials to ensure they are processed correctly. 4. Compost: Compost organic waste to create nutrient-rich soil for gardening. 5. Educate: Spread awareness about waste reduction and encourage others to adopt sustainable practices.")

@bot.command()
async def start(ctx):
    await ctx.send("To start reducing waste, follow these steps: 1. Assess your current waste production. 2. Identify areas where you can reduce consumption. 3. Implement reusable alternatives. 4. Set up a recycling system. 5. Start composting organic waste.")

@bot.command()
async def ile(ctx):
    if ctx.message.content.endswith('Szklo'):
        await ctx.send("Szklo trwa 4000 do nawet 5000 lat zeby sie rozlozyc.")
    elif ctx.message.content.endswith('Plastik'):
        await ctx.send("Plastik 1000 lat.")
    elif ctx.message.content.endswith('Papier'):
        await ctx.send("Papier trwa 2-6 tygodni.")
    elif ctx.message.content.endswith('Baterie'):
        await ctx.send("Baterie trwa 100 lat.")
    elif ctx.message.content.endswith('Odpady organiczne'):
        await ctx.send("Odpady organiczne trwa 2-5 miesiecy.")
    elif ctx.message.content.endswith('Odpady medyczne'):
        await ctx.send("Odpady medyczne trwa 50 lat.")
    elif ctx.message.content.endswith('Odpady elektroniczne'):
        await ctx.send("Odpady elektroniczne trwa 100 lat.")

